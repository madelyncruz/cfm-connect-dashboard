{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Origin",
          "value": "https://cfmconnect.iom.int"
        }
      ],
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://cfmconnect.iom.int"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS"
        }
      ]
    },
    {
